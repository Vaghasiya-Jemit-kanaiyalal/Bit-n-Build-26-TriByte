# Application Configuration
VITE_APP_NAME="WasteWise AI"
VITE_APP_VERSION="1.0.0"

# Backend API Endpoint Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Feature Flags & Demo Mode
