# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/wastewise
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/wastewise_test

# JWT Security
JWT_SECRET_KEY=your-super-secret-jwt-key-minimum-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Role Security
# Public signup permits DRIVER and ANALYST.
# Set to true ONLY for demo / testing if Waste Manager signup is required via UI without seeding.
ALLOW_ADMIN_SELF_SIGNUP=false

# CORS & Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Application
ENVIRONMENT=development
PROJECT_NAME="WasteWise AI"
API_V1_STR=/api/v1
